# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser.
# Used by API routes to validate/consume guest access codes and to serve
# the read-only guest view without giving guests direct DB access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single owner account's email. Sign-up is disabled for everyone else —
# this is the only address the app will treat as "owner".
OWNER_EMAIL=you@example.com

# Random 32+ char secret used to sign the guest session cookie (HMAC).
# Generate one with: openssl rand -base64 32
GUEST_SESSION_SECRET=
